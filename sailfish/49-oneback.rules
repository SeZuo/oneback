/*
 * OneBack: let the user at the device start OneBack's own root helpers
 * from Settings > Android AppSupport, without a password prompt (Sailfish has
 * no polkit agent, so anything that asks would just fail).
 *
 * Only "start", only these unit names, and the per-user units only for the
 * user's own AppSupport instance. The units take no input from the caller:
 * check reads whether OneBack is on in the accessibility settings, hide/show
 * write or delete one fixed config file (hide only while OneBack is on),
 * install installs the APK shipped in this package. Everything else keeps
 * its default policy.
 */
polkit.addRule(function(action, subject) {
    if (action.id !== "org.freedesktop.systemd1.manage-units") {
        return polkit.Result.NOT_HANDLED;
    }
    if (!subject.active || !subject.local) {
        return polkit.Result.NOT_HANDLED;
    }
    if (action.lookup("verb") !== "start") {
        return polkit.Result.NOT_HANDLED;
    }
    var unit = action.lookup("unit");
    if (unit === "oneback-navbar-show.service" ||
            unit === "oneback-navbar-hide@" + subject.user + ".service" ||
            unit === "oneback-check@" + subject.user + ".service" ||
            unit === "oneback-install@" + subject.user + ".service") {
        return polkit.Result.YES;
    }
    return polkit.Result.NOT_HANDLED;
});
